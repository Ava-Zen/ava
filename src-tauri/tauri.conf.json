{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ava",
  "version": "0.1.12",
  "identifier": "com.ava-zen.ava",
  "build": {
    "frontendDist": "../dist/ava/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ava",
        "width": 420,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/models-web/**",
          "$APPDATA/models/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ava"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NUVEQTkwQURCMEZEQQpSV1RhRDlzS3FlMTFDZDNaTG5HMExQa1pScHFoSkRITXIwRzA4RWU1YVlmSlF4a3U1c0drUVV2Lwo=",
      "endpoints": [
        "https://github.com/Ava-Zen/ava/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
